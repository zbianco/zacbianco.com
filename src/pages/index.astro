---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import benton from '../assets/benton.webp';
import city from '../assets/city.webp';
import me from '../assets/me.webp';
import sidney from '../assets/sidney.webp';
import travel1 from '../assets/travel1.webp';
import travel2 from '../assets/travel2.webp';
import travel3 from '../assets/travel3.webp';
import us1 from '../assets/us1.webp';
import us2 from '../assets/us2.webp';
---
<Layout>
	<div class="flex flex-col gap-14">
		<header class="flex flex-col items-center gap-8">
			<div class="flex flex-col gap-2">
				<h1 class="text-5xl font-semibold text-center">Zac Bianco</h1>
				<h3 class="text-2xl font-semibold text-center">Senior Software Developer</h3>
			</div>
			<Image alt="A photo of me" src={me} class="rounded-full overflow-hidden size-60 object-scale-down slide-up-in" />
		</header>
		<div class="flex flex-col items-center gap-6">
			<p class="max-w-prose text-lg">
				Hi! I'm Zac. I'm a software developer who's been focused on front-end solutions using Angular,
				Tailwind CSS, and Nx monorepos.
			</p>
			<p class="max-w-prose text-lg">
				Previously, I worked across a range of .NET, JavaScript, UX, and database technologies, including Windows
				Forms, .NET Web APIs, Angular Material, NgRx, jQuery, Knockout, Bootstrap, SQL Server, Oracle, and MySQL.
			</p>
			<div class="grid grid-cols-3 grid-rows-2 sm:grid-cols-14 sm:grid-rows-1 gap-px items-stretch justify-stretch">
				<Image alt="My cat Benton" src={benton} class="sm:col-span-3 size-full object-cover rounded-sm fade-in" />
				<Image alt="My wife and I in front of the Colosseum in Rome" src={us1} class="col-span-2 sm:col-span-4 size-full object-cover rounded-sm fade-in" />
				<Image alt="My wife and I at Lumen Field in Seattle for a World Cup match" src={us2} class="col-span-2 sm:col-span-4 sm:order-4 size-full object-cover rounded-sm fade-in" />
				<Image alt="My cat Sidney" src={sidney} class="sm:col-span-3 size-full object-cover rounded-sm fade-in" />
			</div>
			<p class="max-w-prose text-lg">
				I live in St. Louis with my wife, Megan, and our two cats, Sidney and Benton. I enjoy traveling, suporting our local MLS team,
				St. Louis CITY SC, and homebrewing.&#32;
				<a href="/on-tap" class="text-accent hover:text-accent-dark transition-colors underline">See what's on tap right now</a>.
			</p>
			<div class="grid grid-cols-3 grid-rows-2 sm:grid-cols-14 sm:grid-rows-1 gap-px items-stretch justify-stretch fade-in">
				<Image alt="The field at Energizer Park during a St. Louis CITY SC match" src={city} class="col-span-2 sm:col-span-4 size-full object-cover rounded-sm fade-in" />
				<Image alt="Crater Lake in Oregon" src={travel1} class="sm:col-span-3 size-full object-cover rounded-sm fade-in" />
				<Image alt="Avalanche Lake in Glacier National Park" src={travel2} class="sm:col-span-3 sm:order-4 size-full object-cover rounded-sm fade-in" />
				<Image alt="Sedona, Arizona" src={travel3} class="col-span-2 sm:col-span-4 size-full object-cover rounded-sm fade-in" />
			</div>
		</div>
	</div>
</Layout>
