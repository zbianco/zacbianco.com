---
import Layout from '../layouts/Layout.astro';
import Beer from '../components/Beer.astro';
---
<Layout title="On Tap">
    <div class="flex flex-col items-stretch gap-16">
      <Beer
        name="Extra Special Bitter"
        abv={5.4}
        ibu={38.3}
        srm={11.4}
        malt={['Pale Ale', 'Caramel', 'Victory']}
        hops={['East Kent Goldings']}
        yeast="Nottingham"
      />
      <Beer
        name="Pineapple Sour"
        abv={5.5}
        ibu={12.9}
        srm={6.7}
        malt={['Pilsen', 'Wheat', 'Pale Ale']}
        hops={['Magnum']}
        yeast="Philly Sour"
        misc={["Pineapple Puree"]}
      />
      <Beer
        name="Mango Sour"
        abv={5.5}
        ibu={12.9}
        srm={6.7}
        malt={['Pilsen', 'Wheat', 'Pale Ale']}
        hops={['Magnum']}
        yeast="Philly Sour"
        misc={["Mango Puree"]}
      />
    </div>
</Layout>
