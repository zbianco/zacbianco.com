---
interface Props {
  name: string;
  abv: number;
  ibu: number;
  srm: number;
  malt: string[];
  hops: string[];
  yeast: string;
}
const { name, abv, ibu, srm, malt, hops, yeast } = Astro.props;
---
<section class="flex flex-col items-stretch gap-4">
	<div class="flex flex-col gap-2">
		<h1 class="text-5xl font-semibold">{name}</h1>
		<span class="flex items-center gap-4 text-xl font-semibold">
			{abv.toLocaleString(undefined, { minimumFractionDigits: 1 })}% ABV
			<span class="flex items-center gap-4 before:inline-block before:size-2 before:rounded-full before:bg-gray-600 after:inline-block after:size-2 after:rounded-full after:bg-gray-600">
				{ibu.toLocaleString(undefined, { minimumFractionDigits: 1 })} IBU
			</span>
			{srm.toLocaleString(undefined, { minimumFractionDigits: 1 })} SRM
		</span>
	</div>
	<div class="flex flex-col">
		<span class="text-sm font-semibold uppercase">Fermentables</span>
		{malt.join(', ')}
	</div>
	<div class="flex flex-col items-start">
		<span class="text-sm font-semibold uppercase">Hops</span>
		<span>{hops.join(', ')}</span>
	</div>
	<div class="flex flex-col items-start">
		<span class="text-sm font-semibold uppercase">Yeast</span>
		<span>{yeast}</span>
	</div>
</section>
